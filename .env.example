# Local Stage 2 API configuration. Replace placeholders locally; never commit secrets.
RURALSTROKE_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
RURALSTROKE_TEST_DATABASE_URL=postgresql+psycopg://<test-user>:<test-password>@<test-host>:5432/<test-database>
RURALSTROKE_ENV=development
RURALSTROKE_STORAGE_BACKEND=filesystem
RURALSTROKE_JWT_SECRET=replace-with-a-local-development-secret
RURALSTROKE_JWT_ISSUER=ruralstroke-local
RURALSTROKE_JWT_AUDIENCE=ruralstroke-api
RURALSTROKE_STORAGE_ROOT=runtime_data/server_attachments
# S3/MinIO deployment settings; use *_FILE for Compose/Secrets Manager mounts.
RURALSTROKE_S3_BUCKET=ruralstroke-attachments
RURALSTROKE_S3_REGION=eu-central-1
RURALSTROKE_S3_ENDPOINT_URL=http://object-store:9000
# Cloud Cognito deployment settings.
RURALSTROKE_AUTH_BACKEND=local
RURALSTROKE_COGNITO_ISSUER=https://cognito-idp.eu-central-1.amazonaws.com/<user-pool-id>
RURALSTROKE_COGNITO_CLIENT_IDS=<collector-client-id>,<clinician-client-id>
