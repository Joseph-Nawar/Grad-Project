# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
.idea/
.vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Ignore raw/processed datasets (never push images to GitHub)
data/

# Ignore AutoKeras, Keras Tuner, and non-release model artifacts.
*.keras
*.h5
*.weights.h5
*.pkl
experiments/
models/

# Stage 3 release and baseline inputs: exact canonical artifacts only.
# Re-include only the parent directories needed to reach each exact file;
# their contents remain ignored unless the final file rule names them.
!/models/
!models/.gitkeep
!models/experiments/
/models/experiments/*
!models/experiments/face/
!models/experiments/face/trial_003_mobilenetv2_balanced_160/
/models/experiments/face/trial_003_mobilenetv2_balanced_160/*
!models/experiments/face/trial_003_mobilenetv2_balanced_160/model.keras
!models/experiments/speech/
!models/experiments/speech/trial_001_mfcc_random_forest/
/models/experiments/speech/trial_001_mfcc_random_forest/*
!models/experiments/speech/trial_001_mfcc_random_forest/model.pkl
!models/experiments/metadata/
!models/experiments/metadata/mvp_metadata_risk_model.pkl
!models/experiments/fer2013/
!models/experiments/fer2013/trial_001_mobilenetv2_160/
/models/experiments/fer2013/trial_001_mobilenetv2_160/*
!models/experiments/fer2013/trial_001_mobilenetv2_160/model.keras

# Explicit pretrained reference profile artifacts; upstream weights remain in ignored external caches.
!models/reference/
/models/reference/*
!models/reference/speech_distilhubert_logistic_regression.joblib
!models/reference/tabpfn_v2_training_context.csv
!models/reference/pretrained_reference_artifacts.json

# CI scratch output and superseded local evidence captures.
/reports/production/stage3/ci-runtime-inventory.json
/reports/production/stage3/*-current.json
/reports/production/stage3/*-final-current.json

# Stage 5 conversion scratch/candidates; only promoted artifacts may enter models/edge/.
/models/edge/*
!/models/edge/.gitkeep
!/models/edge/face-trial-003-litert-fp32.tflite
!/models/edge/speech-trial-001-onnx.onnx
